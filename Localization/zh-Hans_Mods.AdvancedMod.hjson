Items: {
	MetalWormWhip: {
		DisplayName: 金属蠕虫鞭
		Tooltip:
			'''
			12点召唤标记伤害，标记持续4秒
			每次挥鞭首次命中召唤一只探测怪，发动一次随机元素攻击
			鞭打附着1点神圣雷元素；探测怪造成50%伤害，无元素附着
			你的刃杖攻击你标记的敌人时，自身水储量消耗减半
			'''
	}

	RainCloudStaff: {
		DisplayName: 雨云召唤杖
		Tooltip: 召唤一朵随时跟随敌人移动的云朵来向敌人降下大雨，造成一定水元素伤害
	}

	HeavensJudgment: {
		Tooltip:
			'''
			进行连续四段真近战攻击，随着攻击段数提升，伤害也会随之提升。
			右键＋S（向下键）：用2秒展开剑阵、吸收环境元素并收回，使剑刃获得附魔
			水对应水、岩浆对应火、冰对应冰、云对应风；脚下沙块、珍珠沙块、珍珠石块或神圣草对应雷
			格挡：右键可进行格挡，如果此时承受攻击会免疫一半伤害；如果在承受攻击前的瞬间发动，则会免疫全部伤害并生成一对剑进行反击

			[c/808080:根据首位神圣的女皇使用至圣的巨剑代行裁罚的传说复原的大剑，尽管威力远不如传说所述，但是被添加了防御自己和调谐元素的功能]

			[c/0000FF:神圣武器]
			'''
		DisplayName: 天裁之刃
	}

	ElementProbeSword: {
		// Tooltip: ""
		// DisplayName: Element Probe Sword
	}
}

