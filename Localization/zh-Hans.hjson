		Items: {
			PrototypeThunderSword: {
				DisplayName: 原型雷剑
				Tooltip: 命中时附着 1 层雷元素
			}

			PrototypeWindSword: {
				DisplayName: 原型风剑
				Tooltip: 命中时附着 1 层风元素
			}

			PrototypeThunderStaff: {
				DisplayName: 原型雷杖
				Tooltip: 发射雷弹幕，命中时附着 1 层雷元素
			}

			PrototypeWindEnchantAccessory: {
				DisplayName: 风附魔原型饰品
				Tooltip: 将任意原型元素攻击强制转化为风元素
			}

			PrototypeReactionWindBurstAccessory: {
				DisplayName: 风爆原型饰品
				Tooltip: 任意原型反应追加一段 10000 点风元素伤害
			}

			CombustibleEjector: {
				DisplayName: 可燃物发射器
				Tooltip: 发射可燃凝胶，命中时附着 5 层火元素
			}

			AdvancedPyroBottle: {
				DisplayName: 高级火元素瓶
				Tooltip: 火元素伤害提高15%，命中敌人时发射一枚极快的火元素协同光球
			}

			AdvancedThunderBottle: {
				DisplayName: 高级雷元素瓶
				Tooltip: 雷元素伤害提高15%，命中敌人时发射一枚极快的雷元素协同光球
			}

			AdvancedWindBottle: {
				DisplayName: 高级风元素瓶
				Tooltip: 风元素伤害提高15%，命中敌人时发射一枚极快的风元素协同光球
			}

			MoltenBoneHelmet: {
				DisplayName: 熔骨头盔
				Tooltip: 提高50点元素精通
			}

			MoltenBoneBreastplate: {
				DisplayName: 熔骨胸甲
				Tooltip: 全职业伤害提高7%
			}

			MoltenBoneGreaves: {
				DisplayName: 熔骨护腿
				Tooltip: 元素伤害暴击率提高7%
			}

			WindFlower: {
				Tooltip:
					'''
					普通的小花，作为旅途起点的馈赠。
					 发射花形弹幕，对敌方施加 [c/00ffff:风化] 效果，持续造成伤害 
					 [c/0000ff: - 初始武器 - ]
					'''
				DisplayName: 风之花
			}

			InfiniteCrystal: {
				// Tooltip: ""
				// DisplayName: Infinite Crystal
			}

			SiliconBar: {
				DisplayName: 精硅锭
				Tooltip:
					'''
					拆解坠毁的树状图设计者残骸后，提取得到的极高纯度的硅

					[c/00008b:-材料-]
					'''
			}

			SuspiciousCommunicator: {
				DisplayName: 可疑的通讯器
				Tooltip:
					'''
					召唤树状图设计者

					[c/808080:装载了一段特殊讯息的卫星通讯器，不过，你似乎隐约感觉这段讯息似乎会引来意想不到的后果。]

					[c/00008b:-召唤物品-]
					'''
			}

			ElectromagneticWorkStationItem: {
				DisplayName: 电磁操作台
				Tooltip:
					'''
					允许进行精硅和后期机械物品的相关制作，且视为全部世纪之花前制作站

					 [c/808080:太空工程师的秘密设施之一。在解救了他之后，他向你透露了他是如何得以制作那些超乎常人想象的造物。]

					[c/00008b:-制作站-]
					'''
			}
		}

